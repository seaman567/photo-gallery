---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Full-bleed magazine home (no side margins on shell) */
  magazine?: boolean;
}

const brand = '遨游记';
const {
  title = brand,
  description = '这是一些照片的合集和他们背后的故事',
  magazine = false,
} = Astro.props;

const pageTitle = title === brand ? title : `${title} · ${brand}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500&family=Source+Serif+4:ital,wght@0,500;0,600;1,500&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body class:list={[{ 'is-magazine': magazine }]}>
    {
      magazine ? (
        <>
          <header class="mag-header">
            <nav class="site-nav" aria-label="Primary">
              <a href="#aworld">A World</a>
              <a href="#timeline">遨游记</a>
              <a href="#collections">作品集</a>
            </nav>
          </header>
          <main>
            <slot />
          </main>
          <footer class="site-footer mag-footer">
            <div class="site-shell">
              <p>遨游记</p>
            </div>
          </footer>
        </>
      ) : (
        <div class="site-shell">
          <header class="site-header">
            <a class="site-brand" href="/">
              {brand}
            </a>
            <nav class="site-nav" aria-label="Primary">
              <a href="/">相册</a>
            </nav>
          </header>
          <main>
            <slot />
          </main>
          <footer class="site-footer">
            <p>遨游记</p>
          </footer>
        </div>
      )
    }
    <script>
      const nodes = document.querySelectorAll('.reveal');
      if (nodes.length && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        nodes.forEach((el) => io.observe(el));
      } else {
        nodes.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
