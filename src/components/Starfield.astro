---
interface Props {
  density?: number;
}

const { density = 90 } = Astro.props;
---

<canvas
  class="starfield"
  data-density={density}
  aria-hidden="true"
></canvas>

<script>
  function initStarfield(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const density = Number(canvas.dataset.density || 90);

    type Star = {
      x: number;
      y: number;
      r: number;
      base: number;
      twinkle: number;
      phase: number;
      vx: number;
      vy: number;
    };

    let stars: Star[] = [];
    let w = 0;
    let h = 0;
    let dpr = 1;
    let raf = 0;
    let pointer = { x: -9999, y: -9999, active: false };
    let bursts: { x: number; y: number; t: number }[] = [];

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = rect.width;
      h = rect.height;
      canvas.width = Math.floor(w * dpr);
      canvas.height = Math.floor(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const count = Math.max(40, Math.round((w * h) / (14000 / (density / 90))));
      stars = Array.from({ length: count }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        r: Math.random() * 1.4 + 0.35,
        base: Math.random() * 0.45 + 0.25,
        twinkle: Math.random() * 0.8 + 0.4,
        phase: Math.random() * Math.PI * 2,
        vx: (Math.random() - 0.5) * 0.08,
        vy: (Math.random() - 0.5) * 0.08,
      }));
    };

    const draw = (t: number) => {
      ctx.clearRect(0, 0, w, h);

      for (const star of stars) {
        if (!reduceMotion) {
          star.x += star.vx;
          star.y += star.vy;
          if (star.x < -4) star.x = w + 4;
          if (star.x > w + 4) star.x = -4;
          if (star.y < -4) star.y = h + 4;
          if (star.y > h + 4) star.y = -4;
        }

        const dx = star.x - pointer.x;
        const dy = star.y - pointer.y;
        const dist = Math.hypot(dx, dy);
        const influence = pointer.active ? Math.max(0, 1 - dist / 160) : 0;

        if (pointer.active && dist < 140 && !reduceMotion) {
          const push = (1 - dist / 140) * 0.35;
          star.x += (dx / (dist || 1)) * push;
          star.y += (dy / (dist || 1)) * push;
        }

        const twinkle = reduceMotion
          ? star.base
          : star.base + Math.sin(t * 0.0015 * star.twinkle + star.phase) * 0.22;
        const alpha = Math.min(1, twinkle + influence * 0.7);
        const radius = star.r + influence * 1.6;

        ctx.beginPath();
        ctx.fillStyle = `rgba(242, 239, 232, ${alpha})`;
        ctx.arc(star.x, star.y, radius, 0, Math.PI * 2);
        ctx.fill();

        if (influence > 0.15) {
          ctx.beginPath();
          ctx.fillStyle = `rgba(242, 239, 232, ${influence * 0.12})`;
          ctx.arc(star.x, star.y, radius * 4, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      bursts = bursts.filter((b) => {
        const age = (t - b.t) / 700;
        if (age >= 1) return false;
        const r = 8 + age * 70;
        ctx.beginPath();
        ctx.strokeStyle = `rgba(242, 239, 232, ${0.35 * (1 - age)})`;
        ctx.lineWidth = 1;
        ctx.arc(b.x, b.y, r, 0, Math.PI * 2);
        ctx.stroke();
        return true;
      });

      raf = requestAnimationFrame(draw);
    };

    const onMove = (e: PointerEvent) => {
      const rect = canvas.getBoundingClientRect();
      pointer.x = e.clientX - rect.left;
      pointer.y = e.clientY - rect.top;
      pointer.active = true;
    };

    const onLeave = () => {
      pointer.active = false;
      pointer.x = -9999;
      pointer.y = -9999;
    };

    const onDown = (e: PointerEvent) => {
      const rect = canvas.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      bursts.push({ x, y, t: performance.now() });
      for (let i = 0; i < 8; i++) {
        stars.push({
          x: x + (Math.random() - 0.5) * 20,
          y: y + (Math.random() - 0.5) * 20,
          r: Math.random() * 1.2 + 0.4,
          base: 0.7,
          twinkle: 1,
          phase: Math.random() * Math.PI * 2,
          vx: (Math.random() - 0.5) * 0.6,
          vy: (Math.random() - 0.5) * 0.6,
        });
      }
      if (stars.length > density * 2) stars.splice(0, 12);
    };

    resize();
    raf = requestAnimationFrame(draw);
    window.addEventListener('resize', resize);
    canvas.addEventListener('pointermove', onMove);
    canvas.addEventListener('pointerleave', onLeave);
    canvas.addEventListener('pointerdown', onDown);

    return () => {
      cancelAnimationFrame(raf);
      window.removeEventListener('resize', resize);
      canvas.removeEventListener('pointermove', onMove);
      canvas.removeEventListener('pointerleave', onLeave);
      canvas.removeEventListener('pointerdown', onDown);
    };
  }

  document.querySelectorAll<HTMLCanvasElement>('canvas.starfield').forEach(initStarfield);
</script>

<style>
  .starfield {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    cursor: crosshair;
    touch-action: none;
  }
</style>
