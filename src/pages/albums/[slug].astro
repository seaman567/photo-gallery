---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import { albums, getAlbum } from '../../data/albums';
import { isYearArchive, yearLabel, yearPhotoCount } from '../../data/catalog';
import { groupYearPhotosByPlace } from '../../data/places';
import { photoUrl } from '../../data/photoUrl';

export function getStaticPaths() {
  return albums.map((album) => ({
    params: { slug: album.slug },
  }));
}

const { slug } = Astro.params;
const album = getAlbum(slug!);

if (!album) {
  throw new Error(`Album not found: ${slug}`);
}

const asYear = isYearArchive(album);
const year = asYear ? yearLabel(album) : null;
const yearGroups = year ? groupYearPhotosByPlace(year) : [];
const totalCount = asYear ? yearPhotoCount(album) : album.photos.length;
---

<BaseLayout title={album.title} description={album.description}>
  <section class="album-hero">
    <a class="back" href="/">{asYear ? '← 遨游记' : '← 相册'}</a>
    <h1>{asYear ? year : album.title}</h1>
    {!asYear && <p class="desc">{album.description}</p>}
    <p class="meta">{totalCount} 张</p>
  </section>

  {
    asYear ? (
      <div class="year-places" id="gallery" data-album={year ?? album.title}>
        {yearGroups.map((group, gi) => (
          <section class="place-block" aria-labelledby={`place-${group.placeId ?? 'none'}-${gi}`}>
            <h2 class="place-rule" id={`place-${group.placeId ?? 'none'}-${gi}`}>
              {group.href ? (
                <a href={group.href}>{group.title}</a>
              ) : (
                <span>{group.title}</span>
              )}
            </h2>
            <div class="photo-grid">
              {group.photos.map((photo, index) => (
                <a
                  class="photo-cell"
                  href={photoUrl(photo.src)}
                  data-pswp-width={photo.width}
                  data-pswp-height={photo.height}
                  data-cropped="true"
                  style={`animation-delay: ${0.04 * (gi * 6 + index)}s`}
                  target="_blank"
                  rel="noreferrer"
                >
                  <img
                    src={photoUrl(photo.thumb ?? photo.src)}
                    alt={photo.alt}
                    loading={gi === 0 && index < 4 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    ) : (
      <PhotoGrid photos={album.photos} albumTitle={album.title} />
    )
  }
</BaseLayout>

{
  asYear && (
    <script>
      import PhotoSwipeLightbox from 'photoswipe/lightbox';
      import 'photoswipe/style.css';

      const gallery = document.querySelector('#gallery');
      if (gallery) {
        const lightbox = new PhotoSwipeLightbox({
          gallery: '#gallery',
          children: 'a.photo-cell',
          pswpModule: () => import('photoswipe'),
        });
        lightbox.init();
      }
    </script>
  )
}

<style>
  .album-hero {
    padding: 2.5rem 0 1.75rem;
    animation: rise 0.7s var(--ease) both;
  }

  .back {
    display: inline-block;
    margin-bottom: 1rem;
    color: var(--muted);
    font-size: 0.9rem;
    transition: color 0.25s var(--ease);
  }

  .back:hover {
    color: var(--ink);
  }

  h1 {
    margin: 0 0 0.6rem;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    font-weight: 500;
    line-height: 1.05;
  }

  .desc {
    margin: 0 0 0.5rem;
    max-width: 36rem;
    color: var(--muted);
    font-weight: 300;
  }

  .meta {
    margin: 0;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .year-places {
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
    padding-bottom: 3rem;
  }

  .place-rule {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0 0 1.1rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--ink);
  }

  .place-rule a,
  .place-rule span {
    color: inherit;
    text-decoration: none;
  }

  .place-rule a:hover {
    color: var(--accent);
  }

  .place-rule::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  @media (min-width: 720px) {
    .photo-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  .photo-cell {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--bg-elevated);
    animation: rise 0.7s var(--ease) both;
  }

  .photo-cell img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease), filter 0.7s var(--ease);
  }

  .photo-cell:hover img {
    transform: scale(1.04);
    filter: brightness(1.05);
  }
</style>
