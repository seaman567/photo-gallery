---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description="About this personal photo gallery.">
  <section class="about">
    <h1>About</h1>
    <p>
      This is a personal photo showcase built as a static Astro site. Pages deploy to Vercel; large
      images should live on an external host (Cloudflare R2, Aliyun OSS, Cloudinary, etc.) so free
      bandwidth stays healthy.
    </p>
    <p>
      Replace the sample albums in <code>src/data/albums.ts</code> with your own titles and image
      URLs. Use <code>npm run process-photos</code> to generate WebP thumbs from originals in
      <code>photos-src/</code>.
    </p>
  </section>
</BaseLayout>

<style>
  .about {
    padding: 3rem 0 2rem;
    max-width: 36rem;
    animation: rise 0.7s var(--ease) both;
  }

  h1 {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 6vw, 3.4rem);
    font-weight: 500;
  }

  p {
    margin: 0 0 1rem;
    color: var(--muted);
    font-weight: 300;
  }

  code {
    font-size: 0.88em;
    color: var(--ink);
  }
</style>
