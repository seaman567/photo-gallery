---
import BaseLayout from '../layouts/BaseLayout.astro';
import { albums } from '../data/albums';
---

<BaseLayout description="Personal photo albums — coastal light, city grain, and more.">
  <section class="hero">
    <p class="hero-kicker">Personal archive</p>
    <h1 class="hero-brand">Photo Gallery</h1>
    <p class="hero-lead">Selected frames, shown simply. Browse an album to open the lightbox.</p>
    <a class="hero-cta" href="#albums">View albums</a>
  </section>

  <section class="albums" id="albums" aria-label="Albums">
    {
      albums.map((album, index) => (
        <a
          class="album-link"
          href={`/albums/${album.slug}/`}
          style={`animation-delay: ${0.08 * index}s`}
        >
          <img src={album.cover} alt="" loading={index === 0 ? 'eager' : 'lazy'} />
          <div class="album-meta">
            <h2>{album.title}</h2>
            <p>
              <time datetime={album.date}>{album.date}</time>
              <span aria-hidden="true"> · </span>
              {album.photos.length} photos
            </p>
          </div>
        </a>
      ))
    }
  </section>
</BaseLayout>

<style>
  .hero {
    min-height: min(78vh, 720px);
    display: grid;
    align-content: end;
    gap: 0.85rem;
    padding: 4rem 0 3.5rem;
    animation: fade 1s var(--ease) both;
  }

  .hero-kicker {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.72rem;
    color: var(--muted);
  }

  .hero-brand {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(3.4rem, 11vw, 6.5rem);
    line-height: 0.92;
    letter-spacing: -0.02em;
  }

  .hero-lead {
    margin: 0;
    max-width: 28rem;
    color: var(--muted);
    font-weight: 300;
    font-size: 1.05rem;
  }

  .hero-cta {
    display: inline-flex;
    width: fit-content;
    margin-top: 0.5rem;
    padding: 0.7rem 1.15rem;
    border: 1px solid var(--line);
    color: var(--ink);
    font-size: 0.9rem;
    transition:
      border-color 0.25s var(--ease),
      background 0.25s var(--ease);
  }

  .hero-cta:hover {
    border-color: var(--accent);
    background: rgba(122, 158, 138, 0.12);
  }

  .albums {
    display: grid;
    gap: 1.25rem;
    padding-bottom: 2rem;
  }

  @media (min-width: 720px) {
    .albums {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  .album-link {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 11;
    background: var(--bg-elevated);
    animation: rise 0.8s var(--ease) both;
  }

  .album-link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease), filter 0.9s var(--ease);
  }

  .album-link::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 12, 16, 0.85) 0%, transparent 55%);
    pointer-events: none;
  }

  .album-meta {
    position: absolute;
    left: 1.1rem;
    right: 1.1rem;
    bottom: 1rem;
    z-index: 1;
  }

  .album-meta h2 {
    margin: 0 0 0.25rem;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2rem);
    font-weight: 500;
  }

  .album-meta p {
    margin: 0;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .album-link:hover img {
    transform: scale(1.05);
    filter: brightness(1.06);
  }
</style>
